# Copy to `.env.local` for local development against a real Supabase project.
# Do not commit `.env.local` or any file containing real secrets.

# --- Supabase (required for non-demo `pnpm dev`) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key

# --- Object storage (catalog assets) ---
# Provider: supabase (default) | s3 | local
STORAGE_PROVIDER=supabase
# Supabase bucket id / S3 key prefix
STORAGE_BUCKET=catalog

# --- S3 (only when STORAGE_PROVIDER=s3) ---
# STORAGE_S3_BUCKET=your-bucket-name
# AWS_REGION=ap-southeast-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- CMS unlock cookie signing (required in production / hosted preview) ---
# Generate with: openssl rand -base64 32
CMS_UNLOCK_SECRET=

# --- Local demo only (development, not on Vercel) ---
# Enables loopback demo mode: no Supabase login, data in `.data/`.
DEMO_MODE=true

# Optional override for the CMS gate password shown in demo mode UI.
# Default is Abc123 — change only on trusted local machines.
# DEMO_CMS_PASSWORD=
